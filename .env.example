# ---------------------------------------------------------------------------
# MLOps Automation Platform - environment configuration
# Copy to .env and fill in the values:  cp .env.example .env
# ---------------------------------------------------------------------------

# --- GitHub integration ---
GITHUB_TOKEN=ghp_your_personal_access_token
GITHUB_WEBHOOK_SECRET=change-me-webhook-secret

# Public URL of the backend (used to register GitHub webhooks; use ngrok locally)
BACKEND_PUBLIC_URL=http://localhost:8000

# --- Authentication ---
JWT_SECRET_KEY=change-me-to-a-long-random-string
# Bootstrap admin (created on first startup if no users exist)
FIRST_ADMIN_USERNAME=admin
FIRST_ADMIN_PASSWORD=change-me-8-to-72-chars

# --- AI Training Advisor ---
AI_ADVISOR_ENABLED=true

# Provider: anthropic | gemini | ollama
AI_ADVISOR_PROVIDER=anthropic

# Model. Leave empty to use the provider default:
#   anthropic -> claude-opus-4-8
#   gemini    -> gemini-2.5-pro
#   ollama    -> llama3.1
AI_ADVISOR_MODEL=

# provider=anthropic: get a key at https://platform.claude.com
ANTHROPIC_API_KEY=

# provider=gemini: get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# provider=ollama: URL of your Ollama server as seen FROM the backend container.
#   Ollama on the Docker host  -> http://host.docker.internal:11434
#     (on Linux, also add `extra_hosts: ["host.docker.internal:host-gateway"]`
#      to the backend/worker services, or use http://172.17.0.1:11434)
#   Ollama as a compose service -> http://ollama:11434
OLLAMA_BASE_URL=http://host.docker.internal:11434

# --- Object storage (MinIO / S3) ---
# MinIO stores two things:
#   * the datasets users upload from the UI  -> bucket MINIO_BUCKET_DATASETS
#   * the MLflow run artifacts (models, etc) -> bucket MINIO_BUCKET_MLFLOW
# Both buckets are created automatically by the `minio-init` compose service.
# Web console: http://localhost:9001 (log in with the root user/password below).

# Root credentials of the MinIO server (used by the console and by the services).
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin

# Endpoint as seen FROM the containers. Use http://localhost:9000 only if you run
# the backend outside Docker.
MINIO_ENDPOINT=http://minio:9000

# Credentials the backend/worker use to talk to MinIO. In dev these match the
# root credentials; in production create a dedicated service account instead.
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin

# MinIO ignores the region, but boto3 requires one to be set.
MINIO_REGION=us-east-1

# Bucket names.
MINIO_BUCKET_DATASETS=datasets
MINIO_BUCKET_MLFLOW=mlflow

# Maximum size accepted for an uploaded dataset, in megabytes.
DATASET_MAX_SIZE_MB=512

# --- S3 credentials for the MLflow client (mlflow / worker / model-server) ---
# The MLflow artifact store is s3://mlflow/, so every process that reads or writes
# artifacts needs these. docker-compose.yml already derives them from the MINIO_*
# values above, so you normally do NOT need to set them by hand — they are listed
# here for reference and for running any of the services outside Docker.
# MLFLOW_S3_ENDPOINT_URL=http://minio:9000
# AWS_ACCESS_KEY_ID=minioadmin
# AWS_SECRET_ACCESS_KEY=minioadmin
# AWS_DEFAULT_REGION=us-east-1

# --- Observability (Grafana + Prometheus) ---
# The Dashboards section of the app embeds Grafana. Grafana has NO published
# port: it is only reachable through the backend, which authenticates the
# request and then tells Grafana who is asking. Set to false to hide the
# section and stop proxying.
GRAFANA_ENABLED=true

# Grafana as seen from the backend container, and the path it is served under.
GRAFANA_INTERNAL_URL=http://grafana:3000
GRAFANA_PUBLIC_PATH=/grafana

# Header Grafana trusts to identify the user (auth.proxy). The backend sets it
# only after validating the JWT and strips any value the client tried to send.
GRAFANA_AUTH_PROXY_HEADER=X-WEBAUTH-USER

# Read-only PostgreSQL role the dashboards query through. Created automatically
# on backend startup; it can SELECT a fixed list of tables and never sees the
# password hashes. Change the password before exposing this anywhere real.
GRAFANA_DB_USER=grafana_ro
GRAFANA_DB_PASSWORD=grafana_ro

# Set to false to skip provisioning that role (e.g. when the database user has
# no privileges to create roles and you created it by hand).
GRAFANA_DB_ROLE_ENABLED=true

# Public URL of the backend, used to build Grafana's root_url. Must match the
# address the browser uses, or Grafana's own redirects will break the embed.
BACKEND_PUBLIC_URL=http://localhost:8000

# Exposes GET /metrics for Prometheus to scrape.
PROMETHEUS_ENABLED=true

# --- Pipeline behaviour ---
AUTO_DEPLOY_ON_SUCCESS=true
MIN_ACCURACY_THRESHOLD=0.70

# --- Email (dev defaults point at the bundled Mailhog) ---
SMTP_HOST=mailhog
SMTP_PORT=1025
SMTP_USE_TLS=false
SMTP_ENABLED=true
EMAIL_FROM_ADDRESS=noreply@mlops.local

# --- Frontend build args ---
VITE_API_URL=http://localhost:8000
VITE_WS_URL=ws://localhost:8000
