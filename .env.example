# ---------------------------------------------------------------------------
# MLOps Automation Platform - environment configuration
# Copy to .env and fill in the values:  cp .env.example .env
# ---------------------------------------------------------------------------

# --- GitHub integration ---
GITHUB_TOKEN=ghp_your_personal_access_token
GITHUB_WEBHOOK_SECRET=change-me-webhook-secret

# Public URL of the backend (used to register GitHub webhooks; use ngrok locally)
BACKEND_PUBLIC_URL=http://localhost:8000

# --- AI Training Advisor (Claude) ---
# Get a key at https://platform.claude.com — leave empty to disable the advisor
ANTHROPIC_API_KEY=
AI_ADVISOR_ENABLED=true
AI_ADVISOR_MODEL=claude-opus-4-8

# --- Authentication ---
AUTH_SECRET_KEY=change-me-to-a-long-random-string
ADMIN_EMAIL=admin@mlops.local
ADMIN_PASSWORD=admin123

# --- Pipeline behaviour ---
AUTO_DEPLOY_ON_SUCCESS=true
MIN_ACCURACY_THRESHOLD=0.70

# --- Frontend build args ---
VITE_API_URL=http://localhost:8000
VITE_WS_URL=ws://localhost:8000
