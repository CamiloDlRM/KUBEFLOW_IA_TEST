    {
      "id": 9,
      "type": "timeseries",
      "title": "Pipeline runs by outcome",
      "datasource": {
        "type": "postgres",
        "uid": "mlops-postgres"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 21
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "min": 0,
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "bars",
            "lineWidth": 1,
            "fillOpacity": 70,
            "showPoints": "never",
            "stacking": {
              "mode": "normal",
              "group": "A"
            },
            "axisPlacement": "auto"
          },
          "mappings": []
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "postgres",
            "uid": "mlops-postgres"
          },
          "editorMode": "code",
          "rawQuery": true,
          "format": "time_series",
          "rawSql": "SELECT\n  date_trunc('hour', p.finished_at) AS \"time\",\n  p.status AS metric,\n  COUNT(*) AS \"runs\"\nFROM pipelines p\nWHERE p.finished_at IS NOT NULL\n  AND $__timeFilter(p.finished_at)\nGROUP BY 1, 2\nORDER BY 1;"
        }
      ],
      "description": "Pipeline outcomes counted from the pipelines table. Sourced from Postgres rather than Prometheus: the Celery worker runs prefork with more than one child, each child keeps its own metrics registry and only one of them can bind the exporter port, so the Prometheus counter observes a fraction of the runs. The database sees every one."
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "Pipeline duration (p50 / p95)",
      "datasource": {
        "type": "postgres",
        "uid": "mlops-postgres"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 21
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "decimals": 1,
          "min": 0,
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 0,
            "showPoints": "never",
            "axisPlacement": "auto"
          },
          "mappings": []
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "postgres",
            "uid": "mlops-postgres"
          },
          "editorMode": "code",
          "rawQuery": true,
          "format": "time_series",
          "rawSql": "SELECT\n  date_trunc('hour', p.finished_at) AS \"time\",\n  PERCENTILE_CONT(0.50) WITHIN GROUP (\n    ORDER BY EXTRACT(EPOCH FROM (p.finished_at - p.started_at))\n  ) AS \"p50\",\n  PERCENTILE_CONT(0.95) WITHIN GROUP (\n    ORDER BY EXTRACT(EPOCH FROM (p.finished_at - p.started_at))\n  ) AS \"p95\"\nFROM pipelines p\nWHERE p.finished_at IS NOT NULL\n  AND p.started_at IS NOT NULL\n  AND p.finished_at >= p.started_at\n  AND $__timeFilter(p.finished_at)\nGROUP BY 1\nORDER BY 1;"
        }
      ],
      "description": "Pipeline wall-clock duration percentiles, computed in Postgres from started_at/finished_at for the same reason as the outcome panel: the worker-side histogram only observes the child process that owns the exporter port."
    }
