        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "mlops-prometheus"
          },
          "editorMode": "code",
          "expr": "sum(increase(mlops_model_predictions_total{model_name=\"${model}\",status=\"error\"}[24h])) / sum(increase(mlops_model_predictions_total{model_name=\"${model}\"}[24h]))",
          "legendFormat": "__auto",
          "range": false,
          "instant": true
        }
      ]
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Latency p95 (1h)",
      "description": "95th percentile prediction latency at the backend.",
