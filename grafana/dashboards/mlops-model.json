    {
      "id": 10,
      "type": "timeseries",
      "title": "Accuracy by version",
      "description": "Accuracy of every deployed version. The dashed line is the auto-deploy threshold (0.70).",
      "datasource": {
        "type": "postgres",
        "uid": "mlops-postgres"
      },
      "gridPos": {
        "h": 8,
        "w": 16,
        "x": 0,
        "y": 20
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "lineInterpolation": "linear",
            "pointSize": 6,
            "showPoints": "always",
            "fillOpacity": 8,
            "spanNulls": true,
            "axisPlacement": "auto",
            "gradientMode": "opacity",
            "thresholdsStyle": {
              "mode": "dashed"
            }
          },
          "mappings": [],
          "decimals": 3,
          "min": 0,
          "max": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 0.7
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "showLegend": true,
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "postgres",
            "uid": "mlops-postgres"
          },
          "editorMode": "code",
          "rawQuery": true,
          "format": "time_series",
          "rawSql": "SELECT\n  md.deployed_at AS \"time\",\n  md.accuracy AS \"accuracy\"\nFROM model_deployments md\nJOIN pipelines p ON p.id = md.pipeline_id\nJOIN repositories r ON r.id = p.repo_id\nJOIN users u ON u.id = r.owner_id\nWHERE u.username = '${__user.login}'\n  AND md.model_name = '${model}'\n  AND $__timeFilter(md.deployed_at)\nORDER BY 1;"
        }
      ]
    },
    {
      "id": 11,
      "type": "table",
      "title": "Training metrics (active version)",
      "description": "Metrics the training notebook logged for the pipeline that produced the active version.",
      "datasource": {
        "type": "postgres",
        "uid": "mlops-postgres"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 16,
        "y": 20
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "cellOptions": {
              "type": "auto"
            }
          },
          "mappings": []
        },
        "overrides": []
      },
      "options": {
        "showHeader": true,
        "footer": {
          "show": false,
          "reducer": [
            "sum"
          ],
          "fields": ""
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "postgres",
            "uid": "mlops-postgres"
          },
          "editorMode": "code",
          "rawQuery": true,
          "format": "table",
          "rawSql": "SELECT m.key AS \"metric\", m.value AS \"value\"\nFROM model_deployments md\nJOIN pipelines p ON p.id = md.pipeline_id\nJOIN repositories r ON r.id = p.repo_id\nJOIN users u ON u.id = r.owner_id\nCROSS JOIN LATERAL jsonb_each_text(p.metrics::jsonb) m\nWHERE u.username = '${__user.login}'\n  AND md.model_name = '${model}'\n  AND md.is_active\nORDER BY 1;"
        }
      ]
    },
    {
      "id": 12,
      "type": "table",
      "title": "Version history",
      "description": "Every deployed version with the pipeline (commit, branch, duration) that produced it.",
      "datasource": {
        "type": "postgres",
        "uid": "mlops-postgres"
      },
      "gridPos": {
        "h": 10,
        "w": 24,
        "x": 0,
        "y": 28
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "cellOptions": {
              "type": "auto"
            },
            "filterable": true
          },
          "mappings": []
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "accuracy"
            },
            "properties": [
              {
                "id": "unit",
                "value": "percentunit"
              },
              {
                "id": "decimals",
                "value": 3
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "pipeline duration"
            },
            "properties": [
              {
                "id": "unit",
                "value": "s"
              },
              {
                "id": "decimals",
                "value": 0
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "status"
            },
            "properties": [
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "active": {
                        "color": "green",
                        "index": 0
                      },
                      "inactive": {
                        "color": "text",
                        "index": 1
                      }
                    }
                  }
                ]
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-text"
                }
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "footer": {
          "show": false,
          "reducer": [
            "sum"
          ],
          "fields": ""
        },
        "sortBy": [
          {
            "displayName": "deployed",
            "desc": true
          }
        ]
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "postgres",
            "uid": "mlops-postgres"
          },
          "editorMode": "code",
          "rawQuery": true,
          "format": "table",
          "rawSql": "SELECT\n  'v' || md.version AS \"version\",\n  md.deployed_at AS \"deployed\",\n  CASE WHEN md.is_active THEN 'active' ELSE 'inactive' END AS \"status\",\n  md.accuracy AS \"accuracy\",\n  COALESCE(NULLIF(p.branch, ''), r.branch) AS \"branch\",\n  LEFT(p.commit_sha, 8) AS \"commit\",\n  EXTRACT(EPOCH FROM (p.finished_at - p.started_at)) AS \"pipeline duration\",\n  p.id AS \"pipeline\"\nFROM model_deployments md\nJOIN pipelines p ON p.id = md.pipeline_id\nJOIN repositories r ON r.id = p.repo_id\nJOIN users u ON u.id = r.owner_id\nWHERE u.username = '${__user.login}'\n  AND md.model_name = '${model}'\nORDER BY md.deployed_at DESC\nLIMIT 50;"
        }
      ]
    }
  ]
}
