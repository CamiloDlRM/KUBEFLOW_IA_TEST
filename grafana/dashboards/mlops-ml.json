{
  "id": null,
  "uid": "mlops-ml",
  "title": "My Models",
  "description": "Per-user view of training pipelines and deployed models. Every query is scoped to the signed-in user through ${__user.login} -> users.username -> repositories.owner_id.",
  "tags": ["mlops", "ml"],
  "timezone": "browser",
  "editable": false,
  "graphTooltip": 1,
  "schemaVersion": 39,
  "version": 1,
  "refresh": "1m",
  "time": {
    "from": "now-30d",
    "to": "now"
  },
  "annotations": {
    "list": []
  },
  "templating": {
    "list": []
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "My repositories",
      "description": "Active repositories owned by the signed-in user.",
      "datasource": {
        "type": "postgres",
        "uid": "mlops-postgres"
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 0,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "decimals": 0,
          "color": {
            "mode": "fixed",
            "fixedColor": "blue"
          },
          "mappings": []
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": ["lastNotNull"],
          "fields": "",
          "values": false
        },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "postgres",
            "uid": "mlops-postgres"
          },
          "editorMode": "code",
          "rawQuery": true,
          "format": "table",
          "rawSql": "SELECT COUNT(*) AS \"repositories\"\nFROM repositories r\nJOIN users u ON u.id = r.owner_id\nWHERE u.username = '${__user.login}'\n  AND r.is_active;"
        }
      ]
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Deployed models",
      "description": "Distinct model names currently active, deployed from the user's own pipelines.",
      "datasource": {
        "type": "postgres",
        "uid": "mlops-postgres"
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 6,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "decimals": 0,
          "color": {
            "mode": "fixed",
            "fixedColor": "purple"
          },
          "mappings": []
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": ["lastNotNull"],
          "fields": "",
          "values": false
        },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "postgres",
            "uid": "mlops-postgres"
          },
          "editorMode": "code",
          "rawQuery": true,
          "format": "table",
          "rawSql": "SELECT COUNT(DISTINCT d.model_name) AS \"models\"\nFROM model_deployments d\nJOIN pipelines p ON p.id = d.pipeline_id\nJOIN repositories r ON r.id = p.repo_id\nJOIN users u ON u.id = r.owner_id\nWHERE u.username = '${__user.login}'\n  AND d.is_active;"
        }
      ]
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Last accuracy",
      "description": "Accuracy reported by the most recent successful pipeline of this user.",
      "datasource": {
        "type": "postgres",
        "uid": "mlops-postgres"
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 12,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "decimals": 3,
          "min": 0,
          "max": 1,
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "orange",
                "value": 0.7
              },
              {
                "color": "green",
                "value": 0.85
              }
            ]
          },
          "mappings": []
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": ["lastNotNull"],
          "fields": "",
          "values": false
        },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "postgres",
            "uid": "mlops-postgres"
          },
          "editorMode": "code",
          "rawQuery": true,
          "format": "table",
          "rawSql": "SELECT (p.metrics->>'accuracy')::float AS \"last_accuracy\"\nFROM pipelines p\nJOIN repositories r ON r.id = p.repo_id\nJOIN users u ON u.id = r.owner_id\nWHERE u.username = '${__user.login}'\n  AND p.status = 'success'\n  AND p.metrics->>'accuracy' ~ '^-?[0-9]+(\\.[0-9]+)?([eE][-+]?[0-9]+)?$'\nORDER BY p.finished_at DESC NULLS LAST\nLIMIT 1;"
        }
      ]
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Pipeline success rate",
      "description": "Successful runs over finished runs (success + failed) in the selected time range.",
      "datasource": {
        "type": "postgres",
        "uid": "mlops-postgres"
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 18,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "decimals": 1,
          "min": 0,
          "max": 100,
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "orange",
                "value": 60
              },
              {
                "color": "green",
                "value": 85
              }
            ]
          },
          "mappings": []
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": ["lastNotNull"],
          "fields": "",
          "values": false
        },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "postgres",
            "uid": "mlops-postgres"
          },
          "editorMode": "code",
          "rawQuery": true,
          "format": "table",
          "rawSql": "SELECT ROUND(\n         100.0 * COUNT(*) FILTER (WHERE p.status = 'success')\n         / NULLIF(COUNT(*) FILTER (WHERE p.status IN ('success', 'failed')), 0)\n       , 1) AS \"success_rate\"\nFROM pipelines p\nJOIN repositories r ON r.id = p.repo_id\nJOIN users u ON u.id = r.owner_id\nWHERE u.username = '${__user.login}'\n  AND p.started_at IS NOT NULL\n  AND $__timeFilter(p.started_at);"
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Accuracy over time (per repository)",
      "description": "Accuracy extracted from pipelines.metrics JSON for every successful run of the user's repositories.",
      "datasource": {
        "type": "postgres",
        "uid": "mlops-postgres"
      },
      "gridPos": {
        "h": 9,
        "w": 24,
        "x": 0,
        "y": 4
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "decimals": 3,
          "min": 0,
          "max": 1,
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "lineInterpolation": "linear",
            "pointSize": 6,
            "showPoints": "always",
            "fillOpacity": 8,
            "spanNulls": true,
            "axisPlacement": "auto",
            "gradientMode": "opacity"
          },
          "mappings": []
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "showLegend": true,
          "calcs": ["lastNotNull", "max"]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "postgres",
            "uid": "mlops-postgres"
          },
          "editorMode": "code",
          "rawQuery": true,
          "format": "time_series",
          "rawSql": "SELECT\n  p.finished_at AS \"time\",\n  r.github_url || ' @ ' || COALESCE(NULLIF(p.branch, ''), r.branch) AS metric,\n  (p.metrics->>'accuracy')::float AS accuracy\nFROM pipelines p\nJOIN repositories r ON r.id = p.repo_id\nJOIN users u ON u.id = r.owner_id\nWHERE u.username = '${__user.login}'\n  AND p.status = 'success'\n  AND p.finished_at IS NOT NULL\n  AND p.metrics->>'accuracy' ~ '^-?[0-9]+(\\.[0-9]+)?([eE][-+]?[0-9]+)?$'\n  AND $__timeFilter(p.finished_at)\nORDER BY 1;"
        }
      ]
    },
    {
      "id": 6,
      "type": "barchart",
      "title": "Accuracy by branch (main vs testing-ia-agent)",
      "description": "Average and best accuracy per branch, so an AI-suggested branch can be compared against main.",
      "datasource": {
        "type": "postgres",
        "uid": "mlops-postgres"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 13
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "decimals": 3,
          "min": 0,
          "max": 1,
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 80,
            "gradientMode": "none",
            "axisPlacement": "auto"
          },
          "mappings": []
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "runs"
            },
            "properties": [
              {
                "id": "unit",
                "value": "none"
              },
              {
                "id": "custom.hideFrom",
                "value": {
                  "legend": false,
                  "tooltip": false,
                  "viz": true
                }
              }
            ]
          }
        ]
      },
      "options": {
        "xField": "branch",
        "orientation": "horizontal",
        "showValue": "auto",
        "stacking": "none",
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "none"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "postgres",
            "uid": "mlops-postgres"
          },
          "editorMode": "code",
          "rawQuery": true,
          "format": "table",
          "rawSql": "SELECT\n  COALESCE(NULLIF(p.branch, ''), r.branch) AS \"branch\",\n  ROUND(AVG((p.metrics->>'accuracy')::numeric), 4) AS \"avg_accuracy\",\n  ROUND(MAX((p.metrics->>'accuracy')::numeric), 4) AS \"best_accuracy\",\n  COUNT(*) AS \"runs\"\nFROM pipelines p\nJOIN repositories r ON r.id = p.repo_id\nJOIN users u ON u.id = r.owner_id\nWHERE u.username = '${__user.login}'\n  AND p.status = 'success'\n  AND p.metrics->>'accuracy' ~ '^-?[0-9]+(\\.[0-9]+)?([eE][-+]?[0-9]+)?$'\n  AND p.finished_at IS NOT NULL\n  AND $__timeFilter(p.finished_at)\nGROUP BY 1\nORDER BY 2 DESC;"
        }
      ]
    },
    {
      "id": 7,
      "type": "piechart",
      "title": "Pipeline outcomes",
      "description": "Successful vs failed (and still running) pipeline runs in the selected range.",
      "datasource": {
        "type": "postgres",
        "uid": "mlops-postgres"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 13
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "decimals": 0,
          "color": {
            "mode": "palette-classic"
          },
          "mappings": []
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": ["lastNotNull"],
          "fields": "",
          "values": false
        },
        "pieType": "donut",
        "displayLabels": ["name", "value"],
        "legend": {
          "displayMode": "list",
          "placement": "right",
          "showLegend": true,
          "values": ["value"]
        },
        "tooltip": {
          "mode": "single",
          "sort": "none"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "postgres",
            "uid": "mlops-postgres"
          },
          "editorMode": "code",
          "rawQuery": true,
          "format": "table",
          "rawSql": "SELECT\n  p.status AS \"status\",\n  COUNT(*) AS \"runs\"\nFROM pipelines p\nJOIN repositories r ON r.id = p.repo_id\nJOIN users u ON u.id = r.owner_id\nWHERE u.username = '${__user.login}'\n  AND p.started_at IS NOT NULL\n  AND $__timeFilter(p.started_at)\nGROUP BY 1\nORDER BY 2 DESC;"
        }
      ]
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Average pipeline duration",
      "description": "Mean finished_at - started_at per time bucket, for the user's finished pipelines.",
      "datasource": {
        "type": "postgres",
        "uid": "mlops-postgres"
      },
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 21
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "decimals": 1,
          "min": 0,
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "bars",
            "lineWidth": 1,
            "fillOpacity": 60,
            "pointSize": 5,
            "showPoints": "auto",
            "spanNulls": false,
            "gradientMode": "opacity",
            "axisPlacement": "auto"
          },
          "mappings": []
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "none"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "postgres",
            "uid": "mlops-postgres"
          },
          "editorMode": "code",
          "rawQuery": true,
          "format": "time_series",
          "rawSql": "SELECT\n  $__timeGroupAlias(p.started_at, $__interval),\n  AVG(EXTRACT(EPOCH FROM (p.finished_at - p.started_at))) AS \"avg_duration\"\nFROM pipelines p\nJOIN repositories r ON r.id = p.repo_id\nJOIN users u ON u.id = r.owner_id\nWHERE u.username = '${__user.login}'\n  AND p.started_at IS NOT NULL\n  AND p.finished_at IS NOT NULL\n  AND p.finished_at >= p.started_at\n  AND $__timeFilter(p.started_at)\nGROUP BY 1\nORDER BY 1;"
        }
      ]
    },
    {
      "id": 9,
      "type": "table",
      "title": "Recent pipeline runs",
      "description": "Last 50 runs of the user's repositories.",
      "datasource": {
        "type": "postgres",
        "uid": "mlops-postgres"
      },
      "gridPos": {
        "h": 10,
        "w": 24,
        "x": 0,
        "y": 29
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "cellOptions": {
              "type": "auto"
            },
            "filterable": true
          },
          "mappings": []
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "accuracy"
            },
            "properties": [
              {
                "id": "unit",
                "value": "percentunit"
              },
              {
                "id": "decimals",
                "value": 3
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "duration"
            },
            "properties": [
              {
                "id": "unit",
                "value": "s"
              },
              {
                "id": "decimals",
                "value": 0
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "footer": {
          "show": false,
          "reducer": ["sum"],
          "fields": ""
        },
        "sortBy": [
          {
            "displayName": "finished",
            "desc": true
          }
        ]
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "postgres",
            "uid": "mlops-postgres"
          },
          "editorMode": "code",
          "rawQuery": true,
          "format": "table",
          "rawSql": "SELECT\n  p.finished_at AS \"finished\",\n  r.github_url AS \"repository\",\n  COALESCE(NULLIF(p.branch, ''), r.branch) AS \"branch\",\n  p.status AS \"status\",\n  LEFT(p.commit_sha, 8) AS \"commit\",\n  CASE\n    WHEN p.metrics->>'accuracy' ~ '^-?[0-9]+(\\.[0-9]+)?([eE][-+]?[0-9]+)?$'\n    THEN (p.metrics->>'accuracy')::float\n  END AS \"accuracy\",\n  EXTRACT(EPOCH FROM (p.finished_at - p.started_at)) AS \"duration\"\nFROM pipelines p\nJOIN repositories r ON r.id = p.repo_id\nJOIN users u ON u.id = r.owner_id\nWHERE u.username = '${__user.login}'\n  AND p.started_at IS NOT NULL\n  AND $__timeFilter(p.started_at)\nORDER BY p.started_at DESC\nLIMIT 50;"
        }
      ]
    }
  ]
}
