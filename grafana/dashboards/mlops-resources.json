    {
      "id": 10,
      "type": "timeseries",
      "title": "Memory limit used by container",
      "description": "Only containers with a memory limit appear. Near 100% the container is about to be killed.",
      "datasource": {
        "type": "prometheus",
        "uid": "mlops-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
