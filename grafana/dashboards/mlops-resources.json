            "type": "prometheus",
            "uid": "mlops-prometheus"
          },
          "editorMode": "code",
          "expr": "100 * sum by (name) (container_memory_working_set_bytes{name=~\"mlops-.+\"}) / sum by (name) (container_spec_memory_limit_bytes{name=~\"mlops-.+\"} > 0)",
          "legendFormat": "{{name}}",
          "range": true
        }
      ]
